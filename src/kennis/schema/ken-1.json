{
  "$defs": {
    "ContentSource": {
      "additionalProperties": false,
      "description": "A directory of markdown the pack ships, copied verbatim.\n\n`source` is validated here only as far as a string can be: relative, no\nparent segments, no home reference. Whether a file *discovered* under it\nresolves inside the pack root is a filesystem question, and it is asked\nby the walk rather than by the model - a symlink is invisible to this\ncheck by construction.",
      "properties": {
        "exclude": {
          "items": {
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "include": {
          "items": {
            "type": "string"
          },
          "title": "Include",
          "type": "array"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "ContentSource",
      "type": "object"
    },
    "CorpusSection": {
      "additionalProperties": false,
      "description": "The three corpus collections a pack may declare.",
      "properties": {
        "docs": {
          "items": {
            "$ref": "#/$defs/DocsEntry"
          },
          "title": "Docs",
          "type": "array"
        },
        "literature": {
          "items": {
            "$ref": "#/$defs/LiteratureEntry"
          },
          "title": "Literature",
          "type": "array"
        },
        "notes": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ContentSource"
              },
              {
                "$ref": "#/$defs/NoteLink"
              },
              {
                "$ref": "#/$defs/NoteFile"
              }
            ]
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "title": "CorpusSection",
      "type": "object"
    },
    "DocsEntry": {
      "additionalProperties": false,
      "description": "A documentation site the pack declares, crawled from `base_url`.",
      "properties": {
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "exclude": {
          "items": {
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        },
        "pages": {
          "items": {
            "type": "string"
          },
          "title": "Pages",
          "type": "array"
        },
        "project": {
          "title": "Project",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "project"
      ],
      "title": "DocsEntry",
      "type": "object"
    },
    "GeneratedBlock": {
      "additionalProperties": false,
      "description": "Written by `pack update`; never hand-edited. Checksums alone, which\nare a lock file's job: what a person might want to read or change - a\npaper's citekey - is written into its entry instead.\n\n`at` and `by` are restamped only when a digest actually changed, so a\nprovider rebuild that altered nothing leaves the file byte-identical and\nthe fast path of section 5 step 2 keeps its short circuit.",
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "by": {
          "title": "By",
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/GeneratedContent"
        },
        "files": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Files",
          "type": "object"
        }
      },
      "required": [
        "at",
        "by"
      ],
      "title": "GeneratedBlock",
      "type": "object"
    },
    "GeneratedContent": {
      "additionalProperties": false,
      "description": "Digests nested by section and source.\n\nNested rather than a flat map because section 5 keys content on its\n**destination**: the same relative path under `notes/` and under\n`content/` is two different documents, and a bare path could belong to\neither.",
      "properties": {
        "context": {
          "items": {
            "$ref": "#/$defs/GeneratedSource"
          },
          "title": "Context",
          "type": "array"
        },
        "notes": {
          "items": {
            "$ref": "#/$defs/GeneratedSource"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "title": "GeneratedContent",
      "type": "object"
    },
    "GeneratedSource": {
      "additionalProperties": false,
      "description": "The digests of one source's files, keyed by path relative to it.",
      "properties": {
        "files": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Files",
          "type": "object"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "GeneratedSource",
      "type": "object"
    },
    "KennisHeader": {
      "additionalProperties": false,
      "description": "The two fields that decide whether this kennis may read the file.",
      "properties": {
        "min_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Version"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version"
      ],
      "title": "KennisHeader",
      "type": "object"
    },
    "LiteratureEntry": {
      "additionalProperties": false,
      "description": "A paper the pack declares, fetched over the network rather than copied.\n\nThe citekey is a handle for humans - it goes in a `.bib`, in prose and in\na read call. The **identifier** is the identity, which is why one is\nrequired and why section 5 keys the diff on it: correcting a citekey\nagainst an unchanged identifier is a rename, not a delete and a refetch.\nIt may be left out when `url` names the paper, as an arXiv address does.\n\n**Only the identifier is required**, as `corpus add 1101.1764` needs\nnothing else (#459). `kennis pack update` derives what an entry leaves\nout - citekey, title, authors, year - as the add would, and writes it\ninto the entry, as `uv add` writes into `pyproject.toml` (Brian,\n2026-10-26); a field the entry gives is never overridden.\n\n**One identifier field**, which takes an arXiv identifier, a DOI or an\nADS bibcode and is read as whichever it is. Three fields, one per kind,\nasked an author which kind a paper's identifier was and then which wins\nwhen two were given.\n\n`url` is where the text is, when the identifier alone does not reach it.\nThe document found there must not name a different paper.\n\n`group` is a folder inside the pack's own, `literature/<pack id>/`,\nand may hold folders of its own.",
      "properties": {
        "authors": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authors"
        },
        "citekey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citekey"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "title": "LiteratureEntry",
      "type": "object"
    },
    "NoteFile": {
      "additionalProperties": false,
      "description": "One note the pack ships as a file, converted at `corpus sync` as\n`corpus add -n <file>` converts it (Brian, 2026-10-26).\n\nA `source:` folder ships a tree; this ships one file and may name it.\nEach of the three notes models forbids the others' keys, so an entry is\nexactly one of them. `group` is a folder inside `notes/<pack id>/`.",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "file"
      ],
      "title": "NoteFile",
      "type": "object"
    },
    "NoteLink": {
      "additionalProperties": false,
      "description": "A note the pack declares by its address, fetched at `corpus sync`.\n\nConverted as `corpus add -n <url>` converts it, so a pack can declare\nwhatever a person can add (#459). Told apart from a `ContentSource` by\nits required key: each forbids the other's, so an entry naming both is\nneither.\n\n`title` names the note when given; otherwise the page's own title does.\n`group` is a folder inside the pack's own, `notes/<pack id>/`.",
      "properties": {
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "NoteLink",
      "type": "object"
    },
    "PackIdentity": {
      "additionalProperties": false,
      "description": "Who the pack is. `id` is the dedupe key and is stable forever.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "homepage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Homepage"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version"
      ],
      "title": "PackIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A complete, self-describing declaration of what a provider ships.",
  "properties": {
    "context": {
      "items": {
        "$ref": "#/$defs/ContentSource"
      },
      "title": "Context",
      "type": "array"
    },
    "corpus": {
      "$ref": "#/$defs/CorpusSection"
    },
    "generated": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeneratedBlock"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kennis": {
      "$ref": "#/$defs/KennisHeader"
    },
    "pack": {
      "$ref": "#/$defs/PackIdentity"
    }
  },
  "required": [
    "kennis",
    "pack"
  ],
  "title": "Pack",
  "type": "object"
}
